maintainer="dav01d <dav01d@users.noreply.github.com>"
pkgname=remarkable-animator
pkgver=0.2.0
pkgrel=0
upstream_author="dav01d"
category="apps"
pkgdesc="Flipbook animation for the reMarkable Paper Pro, to be used via AppLoad"
url="https://github.com/$upstream_author/RemarkableAnimator"
arch="aarch64"
license="MIT"
depends="appload !rm1 !rm2"
readmeurl="https://raw.githubusercontent.com/$upstream_author/RemarkableAnimator/v$pkgver/README.md"

source="
RemarkableAnimator-$pkgver.tar.gz::https://github.com/$upstream_author/RemarkableAnimator/archive/refs/tags/v$pkgver.tar.gz
"

# backend/entry (static aarch64, from backend/pen.c) and resources.rcc are built and committed upstream
package() {
	set -e
	cd "$srcdir"/RemarkableAnimator-"$pkgver"/src
	_app="$pkgdir"/home/root/xovi/exthome/appload/RemarkableAnimator
	install -Dm755 backend/entry "$_app"/backend/entry
	install -Dm644 resources.rcc "$_app"/resources.rcc
	install -Dm644 manifest.json "$_app"/manifest.json
	install -Dm644 icon.png "$_app"/icon.png
	install -Dm644 ../LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/COPYING
	echo "$url" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	set -e
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.local/share/remarkable-animator
	fi
}
sha512sums='SKIP'
